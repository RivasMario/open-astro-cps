# OpenAstro Udev Rules for Motorola Programming Cables
# Grants non-root user permissions to USB UART programming cables on Linux (Fedora, Ubuntu, Arch)

# FTDI FT232R / FT232BM (Most popular Motorola XTS USB cables)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0666", TAG+="uaccess", GROUP="dialout"

# Prolific PL2303 USB-to-Serial
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", MODE="0666", TAG+="uaccess", GROUP="dialout"

# CH340 / CH341 USB-to-Serial
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0666", TAG+="uaccess", GROUP="dialout"

# Silicon Labs CP210x USB-to-UART
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", TAG+="uaccess", GROUP="dialout"
